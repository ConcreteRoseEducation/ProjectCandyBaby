# Copy to backend/.env on the Pi before `docker compose up`.

POSTGRES_PASSWORD=change-this-password
ADMIN_TOKEN=change-this-teacher-token

# Keep the database on a USB SSD if you have one, e.g. /mnt/ssd/candybaby-pg
# POSTGRES_DATA_DIR=/mnt/ssd/candybaby-pg

# dev = no Firebase required. Students can send X-Dev-User: alice
# firebase = verify Firebase ID tokens (needs a service account later)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=com-example-projectcandy-183ce

TICK_INTERVAL_MS=30000
EVENT_CHANCE_PER_TICK=0.08
STARTING_SUGAR_COINS=1000
CIRCUIT_BREAKER=0.05
